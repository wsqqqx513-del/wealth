<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>五行财富爆发力与天命财局测评</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- html2canvas for Long Image Export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            obsidian: '#0D0E12',
            cardBg: '#16181F',
            cardBorder: '#2A2D3A',
            gold: {
              300: '#F3E5AB',
              400: '#E6CA65',
              500: '#D4AF37',
              600: '#AA820A'
            },
            vermilion: '#C83C23'
          },
          fontFamily: {
            sans: ['Inter', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'sans-serif']
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #0D0E12;
      color: #E2E8F0;
      font-family: 'Inter', 'PingFang SC', 'Microsoft YaHei', sans-serif;
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }

    .gold-gradient-text {
      background: linear-gradient(135deg, #FFF0B3 0%, #D4AF37 50%, #9A7B1C 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .gold-border-glow {
      border: 1px solid rgba(212, 175, 55, 0.3);
      box-shadow: 0 0 15px rgba(212, 175, 55, 0.1);
    }

    .gold-btn {
      background: linear-gradient(135deg, #E6CA65 0%, #D4AF37 50%, #B38F1E 100%);
      color: #0D0E12;
      font-weight: 700;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.25);
    }

    .gold-btn:active {
      transform: scale(0.98);
      box-shadow: 0 2px 8px rgba(212, 175, 55, 0.2);
    }

    .glass-card {
      background: rgba(22, 24, 31, 0.85);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0D0E12;
    }
    ::-webkit-scrollbar-thumb {
      background: #2A2D3A;
      border-radius: 3px;
    }

    /* Fortune Stick Animation */
    @keyframes shakeStick {
      0% { transform: rotate(0deg); }
      25% { transform: rotate(-8deg); }
      50% { transform: rotate(8deg); }
      75% { transform: rotate(-5deg); }
      100% { transform: rotate(0deg); }
    }

    .shaking {
      animation: shakeStick 0.5s ease-in-out infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-gold-500 selection:text-black">

  <header class="w-full border-b border-white/10 py-4 px-4 sticky top-0 z-40 bg-obsidian/90 backdrop-blur-md">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-gold-500/20 border border-gold-500 flex items-center justify-center">
          <i class="fa-solid font-bold text-gold-400 text-sm">卦</i>
        </div>
        <span class="font-bold tracking-wider text-base gold-gradient-text">天命财富局</span>
      </div>
      <div id="usageBadge" class="hidden text-xs bg-gold-500/10 text-gold-400 px-3 py-1 rounded-full border border-gold-500/30">
        剩余次数: <span id="remainingCount">3</span>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="flex-grow w-full max-w-md mx-auto px-4 py-6">

    <section id="viewPassword" class="space-y-6">
      <div class="text-center space-y-3 py-4">
        <div class="inline-block px-3 py-1 rounded-full bg-gold-500/10 text-gold-400 text-xs tracking-widest uppercase border border-gold-500/30">
          九星天干 · 财局精算
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold gold-gradient-text tracking-tight">
          五行财富爆发力测评
        </h1>
        <p class="text-xs text-gray-400 leading-relaxed px-4">
          通过原生生辰五行与后天商业抉择，精准分析你的爆财周期、破财避坑指南与天命财富格局。
        </p>
      </div>

      <div class="glass-card rounded-2xl p-6 gold-border-glow space-y-5">
        <div class="space-y-2">
          <label class="block text-xs text-gold-300 font-medium">请输入8位激活卡密</label>
          <div class="relative">
            <input type="text" id="passwordInput" maxlength="8" placeholder="请输入8位卡密解锁" 
              class="w-full bg-black/50 border border-cardBorder rounded-xl px-4 py-3.5 text-center text-lg tracking-widest text-gold-400 font-mono focus:outline-none focus:border-gold-500 uppercase">
          </div>
        </div>

        <button onclick="verifyPassword()" class="w-full gold-btn py-3.5 rounded-xl font-bold text-base flex items-center justify-center gap-2">
          <span>解 锁 测 评</span>
          <i class="fa-solid fa-key text-xs"></i>
        </button>

        <p class="text-xs text-center text-gray-500">
          全网已为 142,890+ 人解锁财富天命局
        </p>
      </div>
    </section>

    <section id="viewBirthInfo" class="hidden space-y-6">
      <div class="text-center space-y-2">
        <h2 class="text-xl font-bold gold-gradient-text">输入生辰盘骨</h2>
        <p class="text-xs text-gray-400">结合《三命通会》与五行生克自动测算原生财富气场</p>
      </div>

      <div class="glass-card rounded-2xl p-6 border border-cardBorder space-y-4">
        <!-- Name -->
        <div class="space-y-1">
          <label class="text-xs text-gray-300">姓名 / 昵称</label>
          <input type="text" id="userName" placeholder="请输入您的名字" 
            class="w-full bg-black/40 border border-cardBorder rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-gold-500">
        </div>

        <!-- Gender -->
        <div class="space-y-1">
          <label class="text-xs text-gray-300">性别</label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" onclick="selectGender('male')" id="genderMale" class="gender-btn active py-2.5 rounded-xl border border-gold-500 bg-gold-500/20 text-gold-300 text-sm font-medium flex items-center justify-center gap-2">
              <i class="fa-solid fa-mars"></i> 乾造 (男)
            </button>
            <button type="button" onclick="selectGender('female')" id="genderFemale" class="gender-btn py-2.5 rounded-xl border border-cardBorder bg-black/40 text-gray-400 text-sm font-medium flex items-center justify-center gap-2">
              <i class="fa-solid fa-venus"></i> 坤造 (女)
            </button>
          </div>
        </div>

        <!-- Calendar Type -->
        <div class="space-y-1">
          <label class="text-xs text-gray-300">历法类型</label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" onclick="selectCalendar('gregorian')" id="calGregorian" class="cal-btn active py-2 rounded-xl border border-gold-500 bg-gold-500/20 text-gold-300 text-xs font-medium">
              公历 (阳历)
            </button>
            <button type="button" onclick="selectCalendar('lunar')" id="calLunar" class="cal-btn py-2 rounded-xl border border-cardBorder bg-black/40 text-gray-400 text-xs font-medium">
              农历 (阴历)
            </button>
          </div>
        </div>

        <!-- Birth Date/Time -->
        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-xs text-gray-300">出生日期</label>
            <input type="date" id="birthDate" value="1995-08-18" class="w-full bg-black/40 border border-cardBorder rounded-xl px-3 py-2.5 text-xs text-gray-200 focus:outline-none focus:border-gold-500">
          </div>
          <div class="space-y-1">
            <label class="text-xs text-gray-300">出生时辰</label>
            <select id="birthHour" class="w-full bg-black/40 border border-cardBorder rounded-xl px-3 py-2.5 text-xs text-gray-200 focus:outline-none focus:border-gold-500">
              <option value="0">子时 (23:00-01:00)</option>
              <option value="2">丑时 (01:00-03:00)</option>
              <option value="4">寅时 (03:00-05:00)</option>
              <option value="6">卯时 (05:00-07:00)</option>
              <option value="8" selected>辰时 (07:00-09:00)</option>
              <option value="10">巳时 (09:00-11:00)</option>
              <option value="12">午时 (11:00-13:00)</option>
              <option value="14">未时 (13:00-15:00)</option>
              <option value="16">申时 (15:00-17:00)</option>
              <option value="18">酉时 (17:00-19:00)</option>
              <option value="20">戌时 (19:00-21:00)</option>
              <option value="22">亥时 (21:00-23:00)</option>
            </select>
          </div>
        </div>

        <button onclick="startQuiz()" class="w-full gold-btn py-3.5 rounded-xl font-bold text-base mt-2">
          开启天命财局测评
        </button>
      </div>
    </section>

    <section id="viewQuiz" class="hidden space-y-5">
      <!-- Progress Bar -->
      <div class="space-y-2">
        <div class="flex justify-between text-xs">
          <span class="text-gray-400">答题进度</span>
          <span class="text-gold-400 font-mono font-bold"><span id="currentQNum">1</span> / 12</span>
        </div>
        <div class="w-full h-1.5 bg-black/50 rounded-full overflow-hidden border border-white/5">
          <div id="quizProgressBar" class="h-full bg-gradient-to-r from-gold-600 to-gold-400 transition-all duration-300" style="width: 8.33%;"></div>
        </div>
      </div>

      <!-- Question Card -->
      <div class="glass-card rounded-2xl p-6 border border-cardBorder space-y-5 min-h-[360px] flex flex-col justify-between">
        <div class="space-y-4">
          <div class="inline-block px-2.5 py-0.5 rounded text-[10px] bg-gold-500/10 text-gold-400 border border-gold-500/20 font-mono">
            QUESTION <span id="qTag">01</span>
          </div>
          <h3 id="qTitle" class="text-base sm:text-lg font-bold text-gray-100 leading-snug">
            <!-- Dynamic Question -->
          </h3>
        </div>

        <!-- Options list (No suffix tags) -->
        <div id="qOptions" class="space-y-3">
          <!-- Dynamic 4 Options -->
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-white/5">
          <button id="btnPrev" onclick="prevQuestion()" class="text-xs text-gray-400 hover:text-gold-300 flex items-center gap-1 py-2 px-3 rounded-lg border border-white/5 bg-white/5">
            <i class="fa-solid fa-chevron-left text-[10px]"></i> 返回上一题
          </button>
          <span class="text-[10px] text-gray-500">选择符合真实情况的项</span>
        </div>
      </div>
    </section>

    <section id="viewReport" class="hidden space-y-6">
      
      <!-- Exportable Card Area -->
      <div id="reportExportArea" class="glass-card rounded-2xl p-5 border border-gold-500/30 space-y-6 bg-obsidian">
        
        <!-- Header -->
        <div class="text-center space-y-1 border-b border-white/10 pb-4">
          <p class="text-[10px] tracking-widest text-gold-400 uppercase">天命局分析报告</p>
          <h2 id="repUserName" class="text-xl font-extrabold gold-gradient-text">-- 的五行财富爆发力</h2>
          <p id="repBirthSummary" class="text-[11px] text-gray-400 font-mono"></p>
        </div>

        <!-- Tier Banner -->
        <div class="bg-gradient-to-r from-gold-500/10 via-gold-500/20 to-gold-500/10 border border-gold-500/40 rounded-xl p-4 text-center space-y-1">
          <div class="text-xs text-gold-300 font-medium">爆发力等级诊断</div>
          <div id="repTier" class="text-2xl font-black text-gold-400 tracking-wide gold-gradient-text">
            --
          </div>
          <p id="repTierDesc" class="text-xs text-gray-300 px-2 leading-relaxed"></p>
        </div>

        <!-- Radar Charts Section (Native Canvas) -->
        <div class="space-y-5">
          <div class="space-y-2">
            <h4 class="text-xs font-bold text-gold-400 flex items-center gap-2">
              <i class="fa-solid fa-star-of-david"></i> 原生五行气场雷达 (五角)
            </h4>
            <div class="bg-black/40 rounded-xl p-3 border border-white/5 flex flex-col items-center">
              <canvas id="canvasFiveElements" width="280" height="240" class="w-full max-w-[280px] h-auto"></canvas>
              <div id="wuxingRatioText" class="text-[11px] text-gray-400 mt-2 text-center font-mono"></div>
            </div>
          </div>

          <div class="space-y-2">
            <h4 class="text-xs font-bold text-gold-400 flex items-center gap-2">
              <i class="fa-solid fa-chart-pie"></i> 后天商业变现力雷达 (四维)
            </h4>
            <div class="bg-black/40 rounded-xl p-3 border border-white/5 flex flex-col items-center">
              <canvas id="canvasBusinessRadar" width="280" height="240" class="w-full max-w-[280px] h-auto"></canvas>
            </div>
          </div>
        </div>

        <!-- Diagnosis & Fortunes -->
        <div class="space-y-4">
          <!-- 天命财局诊断 -->
          <div class="bg-black/30 border border-cardBorder rounded-xl p-4 space-y-2">
            <h4 class="text-xs font-bold text-gold-300 flex items-center gap-1.5">
              <i class="fa-solid fa-compass text-gold-400"></i> 天命财局诊断
            </h4>
            <p id="repDiagnosis" class="text-xs text-gray-300 leading-relaxed"></p>
          </div>

          <!-- 财富建议与增运锦囊 -->
          <div class="bg-black/30 border border-cardBorder rounded-xl p-4 space-y-2">
            <h4 class="text-xs font-bold text-gold-300 flex items-center gap-1.5">
              <i class="fa-solid fa-gem text-gold-400"></i> 财富建议与增运锦囊
            </h4>
            <ul id="repAdviceList" class="text-xs text-gray-300 space-y-1.5 list-disc list-inside"></ul>
          </div>

          <!-- 破财避坑指南 -->
          <div class="bg-vermilion/10 border border-vermilion/30 rounded-xl p-4 space-y-2">
            <h4 class="text-xs font-bold text-red-400 flex items-center gap-1.5">
              <i class="fa-solid fa-shield-halved"></i> 破财避坑指南
            </h4>
            <p id="repAvoid" class="text-xs text-gray-300 leading-relaxed"></p>
          </div>
        </div>

        <!-- Watermark footer inside export -->
        <div class="pt-2 text-center border-t border-white/10 text-[10px] text-gray-500">
          天命财富局 · 算法精算认证
        </div>
      </div>

      <div class="glass-card rounded-2xl p-5 border border-gold-500/30 space-y-3 text-center">
        <h4 class="text-sm font-bold gold-gradient-text">今日财神灵签</h4>
        <p class="text-xs text-gray-400">点击摇签，测算今日财富吉凶位与灵机</p>
        
        <div id="stickContainer" class="py-2 cursor-pointer" onclick="drawFortuneStick()">
          <div id="stickBox" class="w-16 h-24 mx-auto bg-gradient-to-b from-amber-800 to-amber-950 rounded-b-xl border-2 border-gold-500/50 flex flex-col items-center justify-end p-2 relative shadow-lg">
            <div class="w-2 h-16 bg-amber-200 rounded-t border border-amber-600 -mt-6"></div>
            <span class="text-[10px] text-gold-300 font-bold mt-1">财神筒</span>
          </div>
        </div>

        <div id="stickResult" class="hidden bg-black/50 p-3 rounded-xl border border-gold-500/20 text-xs space-y-1">
          <div id="stickTitle" class="font-bold text-gold-400">--</div>
          <div id="stickText" class="text-gray-300">--</div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-3 pt-2">
        <button onclick="exportReportImage()" class="w-full gold-btn py-3.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2">
          <i class="fa-solid fa-download"></i> 保存测评报告长图
        </button>

        <div class="grid grid-cols-2 gap-3">
          <button onclick="copyResultLink()" class="py-3 rounded-xl border border-gold-500/40 bg-gold-500/10 text-gold-300 text-xs font-bold flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-link"></i> 复制结果链接
          </button>
          <button onclick="showGiftModal()" class="py-3 rounded-xl border border-red-500/40 bg-red-500/10 text-red-300 text-xs font-bold flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-gift"></i> 好评领返现
          </button>
        </div>

        <button onclick="restartTest()" class="w-full py-3 rounded-xl border border-cardBorder bg-black/40 text-gray-400 text-xs font-medium hover:text-gold-300">
          消耗次数 · 重新测评
        </button>
      </div>

    </section>

  </main>

  <div id="giftModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="glass-card border border-gold-500/40 rounded-2xl max-w-sm w-full p-6 text-center space-y-4">
      <div class="w-12 h-12 rounded-full bg-red-500/20 border border-red-500 text-red-400 flex items-center justify-center mx-auto text-xl">
        <i class="fa-solid fa-hand-holding-dollar"></i>
      </div>
      <h3 class="text-base font-bold text-gold-300">好评有礼 · 领取1元返现</h3>
      <p class="text-xs text-gray-300 leading-relaxed">
        截图本测评结果长图，并提供五星好评，联系官方客服微信即可立领 <span class="text-gold-400 font-bold">1元现金红包</span>！
      </p>
      <div class="bg-black/50 p-3 rounded-xl border border-white/10 text-xs font-mono text-gold-400 select-all">
        客服微信号: fortune_service88
      </div>
      <button onclick="hideGiftModal()" class="w-full gold-btn py-2.5 rounded-xl font-bold text-xs">
        确 定
      </button>
    </div>
  </div>

  <!-- Message Toast -->
  <div id="toast" class="fixed bottom-10 left-1/2 transform -translate-x-1/2 bg-gold-500 text-black text-xs font-bold px-4 py-2.5 rounded-full shadow-2xl opacity-0 transition-opacity duration-300 pointer-events-none z-50">
    提示信息
  </div>

  <!-- Footer -->
  <footer class="w-full text-center py-4 text-[10px] text-gray-600 border-t border-white/5">
    五行天命财局测评算法系统 © 2026 版权所有
  </footer>

  <script>
    /* =========================================================================
       1. PASSWORDS & STATE MANAGEMENT
       ========================================================================= */
    // Built-in 100 Password list
    const BUILTIN_PASSWORDS = [
      "ESS4DIVU", "2T011VIW", "D3Q3YYHJ", "9729SCMU", "KQ5ZUAZN",
      "P7K8W2NE", "L9M4X1QA", "B3V7C2XR", "J5N1K8ZP", "H4F6G9TY",
      "W2E5R8TU", "Y1U4I7OP", "A3S6D9FG", "H2J5K8LZ", "X9C2V5BN",
      "M1N4B7VC", "X3Z6L9KJ", "H8G5F2DA", "S1D4F7GH", "J2K5L8ZX",
      "C9V2B5NM", "Q1W4E7RT", "Y8U5I2OP", "A9S2D5FG", "H8J1K4LZ",
      "P3O6I9UB", "Y2T5R8WE", "Q9W2E5RT", "U8I1O4PS", "A7S0D3FG",
      "H6J9K2LZ", "X5C8V1BN", "M4N7B0VC", "X3Z6L9KA", "H2G5F8DA",
      "S9D2F5GH", "J8K1L4ZX", "C7V0B3NM", "Q6W9E2RT", "Y5U8I1OP",
      "A4S7D0FG", "H3J6K9LZ", "X2C5V8BN", "M1N4B7VA", "X0Z3L6KJ",
      "H9G2F5DA", "S8D1F4GH", "J7K0L3ZX", "C6V9B2NM", "Q5W8E1RT",
      "Y4U7I0OP", "A3S6D9FA", "H2J5K8LA", "X1C4V7BN", "M0N3B6VC",
      "X9Z2L5KJ", "H8G1F4DA", "S7D0F3GH", "J6K9L2ZX", "C5V8B1NM",
      "Q4W7E0RT", "Y3U6I9OP", "A2S5D8FG", "H1J4K7LZ", "X0C3V6BN",
      "M9N2B5VC", "X8Z1L4KJ", "H7G0F3DA", "S6D9F2GH", "J5K8L1ZX",
      "C4V7B0NM", "Q3W6E9RT", "Y2U5I8OP", "A1S4D7FG", "H0J3K6LZ",
      "X9C2V5BA", "M8N1B4VC", "X7Z0L3KJ", "H6G9F2DA", "S5D8F1GH",
      "J4K7L0ZX", "C3V6B9NM", "Q2W5E8RT", "Y1U4I7OA", "A0S3D6FG",
      "H9J2K5LZ", "X8C1V4BN", "M7N0B3VC", "X6Z9L2KJ", "H5G8F1DA",
      "S4D7F0GH", "J3K6L9ZX", "C2V5B8NM", "Q1W4E7RA", "Y0U3I6OP"
    ];

    // Current Session State
    let state = {
      activePassword: '',
      remainingCount: 3,
      userName: '',
      gender: 'male',
      calendar: 'gregorian',
      birthDate: '1995-08-18',
      birthHour: '8',
      currentQuestionIndex: 0,
      answers: new Array(12).fill(null),
      wuxingScores: { wood: 0, fire: 0, earth: 0, metal: 0, water: 0 },
      businessScores: { strategy: 0, execution: 0, resource: 0, wind: 0 }
    };

    function getStoredUsage(pwd) {
      const data = localStorage.getItem('wuxing_pwd_' + pwd);
      if (data !== null) {
        return parseInt(data, 10);
      }
      return 3; // Default 3 usages
    }

    function setStoredUsage(pwd, count) {
      localStorage.setItem('wuxing_pwd_' + pwd, count);
    }

    function verifyPassword() {
      const input = document.getElementById('passwordInput').value.trim().toUpperCase();
      if (!input) {
        showToast('请输入8位激活密码');
        return;
      }

      if (!BUILTIN_PASSWORDS.includes(input)) {
        showToast('密码无效或格式不正确');
        return;
      }

      const count = getStoredUsage(input);
      if (count <= 0) {
        showToast('该密码3次测试额度已用完');
        return;
      }

      state.activePassword = input;
      state.remainingCount = count;

      document.getElementById('remainingCount').innerText = count;
      document.getElementById('usageBadge').classList.remove('hidden');

      showToast('激活成功，剩余额度 ' + count + ' 次');
      switchView('viewBirthInfo');
    }

    /* =========================================================================
       2. BAZI & FIVE ELEMENTS CALCULATOR
       ========================================================================= */
    function selectGender(g) {
      state.gender = g;
      document.querySelectorAll('.gender-btn').forEach(btn => {
        btn.classList.remove('active', 'border-gold-500', 'bg-gold-500/20', 'text-gold-300');
        btn.classList.add('border-cardBorder', 'bg-black/40', 'text-gray-400');
      });
      const activeBtn = document.getElementById(g === 'male' ? 'genderMale' : 'genderFemale');
      activeBtn.classList.add('active', 'border-gold-500', 'bg-gold-500/20', 'text-gold-300');
    }

    function selectCalendar(c) {
      state.calendar = c;
      document.querySelectorAll('.cal-btn').forEach(btn => {
        btn.classList.remove('active', 'border-gold-500', 'bg-gold-500/20', 'text-gold-300');
        btn.classList.add('border-cardBorder', 'bg-black/40', 'text-gray-400');
      });
      const activeBtn = document.getElementById(c === 'gregorian' ? 'calGregorian' : 'calLunar');
      activeBtn.classList.add('active', 'border-gold-500', 'bg-gold-500/20', 'text-gold-300');
    }

    // Hash date to get deterministic native Wuxing
    function calculateNativeWuxing(dateStr, hour) {
      let hash = 0;
      const combined = dateStr + hour + (state.gender === 'male' ? '1' : '0');
      for (let i = 0; i < combined.length; i++) {
        hash = (hash << 5) - hash + combined.charCodeAt(i);
        hash |= 0;
      }
      hash = Math.abs(hash);

      const baseWood = 15 + (hash % 20);
      const baseFire = 15 + ((hash >> 2) % 25);
      const baseEarth = 15 + ((hash >> 4) % 20);
      const baseMetal = 15 + ((hash >> 6) % 20);
      const baseWater = 100 - (baseWood + baseFire + baseEarth + baseMetal);

      return {
        wood: Math.max(10, baseWood),
        fire: Math.max(10, baseFire),
        earth: Math.max(10, baseEarth),
        metal: Math.max(10, baseMetal),
        water: Math.max(10, baseWater)
      };
    }

