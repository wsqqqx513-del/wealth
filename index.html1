    function startQuiz() {
      const name = document.getElementById('userName').value.trim();
      if (!name) {
        showToast('请输入您的姓名或昵称');
        return;
      }
      state.userName = name;
      state.birthDate = document.getElementById('birthDate').value;
      state.birthHour = document.getElementById('birthHour').value;
      
      // Reset quiz
      state.currentQuestionIndex = 0;
      state.answers.fill(null);

      renderQuestion();
      switchView('viewQuiz');
    }

    function renderQuestion() {
      const qIndex = state.currentQuestionIndex;
      const qData = QUIZ_QUESTIONS[qIndex];

      document.getElementById('currentQNum').innerText = qIndex + 1;
      document.getElementById('qTag').innerText = (qIndex + 1 < 10 ? '0' : '') + (qIndex + 1);
      document.getElementById('qTitle').innerText = qData.title;

      const progress = ((qIndex + 1) / 12) * 100;
      document.getElementById('quizProgressBar').style.width = progress + '%';

      // Render Clean 4 Options (No Suffix)
      const optionsContainer = document.getElementById('qOptions');
      optionsContainer.innerHTML = '';

      const letters = ['A', 'B', 'C', 'D'];
      qData.options.forEach((opt, idx) => {
        const isSelected = state.answers[qIndex] === idx;
        const btn = document.createElement('button');
        btn.className = `w-full p-4 rounded-xl text-left border text-xs sm:text-sm flex items-start gap-3 transition-all ${
          isSelected 
            ? 'border-gold-500 bg-gold-500/20 text-gold-300 font-bold' 
            : 'border-cardBorder bg-black/40 text-gray-300 hover:border-gold-500/50'
        }`;
        
        btn.onclick = () => selectOption(idx);
        btn.innerHTML = `
          <span class="w-5 h-5 rounded-full border border-gold-500/40 flex items-center justify-center text-[10px] font-mono text-gold-400 flex-shrink-0 mt-0.5">
            ${letters[idx]}
          </span>
          <span class="leading-relaxed">${opt.text}</span>
        `;
        optionsContainer.appendChild(btn);
      });

      // Show/Hide prev button
      document.getElementById('btnPrev').style.visibility = qIndex === 0 ? 'hidden' : 'visible';
    }

    function selectOption(optIndex) {
      state.answers[state.currentQuestionIndex] = optIndex;

      if (state.currentQuestionIndex < 11) {
        state.currentQuestionIndex++;
        renderQuestion();
      } else {
        // Quiz completed, calculate report
        generateReport();
      }
    }

    function prevQuestion() {
      if (state.currentQuestionIndex > 0) {
        state.currentQuestionIndex--;
        renderQuestion();
      }
    }

    /* =========================================================================
       3. CALCULATE REPORT & TIER DIAGNOSTICS
       ========================================================================= */
    function generateReport() {
      // Deduct usage
      if (state.activePassword) {
        state.remainingCount = Math.max(0, state.remainingCount - 1);
        setStoredUsage(state.activePassword, state.remainingCount);
        document.getElementById('remainingCount').innerText = state.remainingCount;
      }

      // Calculate Native BaZi Wuxing
      const native = calculateNativeWuxing(state.birthDate, state.birthHour);

      // Accumulate answer scores
      let wWood = native.wood, wFire = native.fire, wEarth = native.earth, wMetal = native.metal, wWater = native.water;
      let bStrat = 20, bExec = 20, bRes = 20, bWind = 20;

      state.answers.forEach((ansIndex, qIdx) => {
        if (ansIndex !== null) {
          const opt = QUIZ_QUESTIONS[qIdx].options[ansIndex];
          wWood += opt.wood || 0;
          wFire += opt.fire || 0;
          wEarth += opt.earth || 0;
          wMetal += opt.metal || 0;
          wWater += opt.water || 0;

          bStrat += opt.strat || 0;
          bExec += opt.exec || 0;
          bRes += opt.res || 0;
          bWind += opt.wind || 0;
        }
      });

      // Normalize Wuxing to %
      const totalW = wWood + wFire + wEarth + wMetal + wWater;
      state.wuxingScores = {
        wood: Math.round((wWood / totalW) * 100),
        fire: Math.round((wFire / totalW) * 100),
        earth: Math.round((wEarth / totalW) * 100),
        metal: Math.round((wMetal / totalW) * 100),
        water: Math.round((wWater / totalW) * 100)
      };

      state.businessScores = {
        strategy: Math.min(100, bStrat),
        execution: Math.min(100, bExec),
        resource: Math.min(100, bRes),
        wind: Math.min(100, bWind)
      };

      // Populate Report Text
      document.getElementById('repUserName').innerText = `${state.userName} 的五行财富爆发力`;
      document.getElementById('repBirthSummary').innerText = 
        `出生日期: ${state.birthDate} | ${state.gender === 'male' ? '乾造' : '坤造'} | ${state.calendar === 'gregorian' ? '公历' : '农历'}`;

      // Calculate Tier
      const totalBiz = bStrat + bExec + bRes + bWind;
      let tier = "S级 · 稳健稳扎破局者";
      let tierDesc = "你具备极佳的商业基础与风险控制力，善于积蓄能量，在稳健中寻找确定性收益。";
      let diagnosis = "你的天命财局属于【积沙成塔】型。命理气场中原生能量沉稳，后天商业洞察扎实。你不容易掉入盲目炒作的陷阱，但有时可能因过度谨慎而错过短线暴富的风口。";
      let advice = [
        "适合副业赛道：知识付费、高客单专业咨询、资产配置服务",
        "幸运增运颜色：帝王金、绛紫色",
        "财富贵人属相：属猴、属鸡、属鼠之人"
      ];
      let avoid = "切忌在自身认知不清晰的领域盲目跟风做大额杠杆投资，防止出现长期流动性锁死。";

      if (totalBiz >= 140) {
        tier = "SSS级 · 风口提款机";
        tierDesc = "天赋异禀的商业嗅觉与极强资源整合力，极易在时代红利与新赛道中瞬间爆发暴富！";
        diagnosis = "你的天命财局属于【烈火炼金】爆发型！天干地支气场极具张力，后天商业维度无死角。你天生对流量、风口和变现机会极为敏感，能迅速将人脉与信息差转化为真金白银。";
        advice = [
          "适合副业赛道：短视频IP直播、跨界出海电商、爆款项目操盘",
          "幸运增运颜色：朱砂红、亮金色",
          "财富贵人属相：属虎、属马、属蛇之人"
        ];
        avoid = "防范因欲望扩张过快导致团队管控失效或因税务、法务细节疏漏而造成重大利润回撤。";
      } else if (totalBiz >= 115) {
        tier = "SS级 · 复利大佬";
        tierDesc = "兼具战略格局与执行定力，擅长通过系统化架构打造长期现金流管道。";
        diagnosis = "你的天命财局属于【水木相生】长青型。你兼具长远战略布局与极强的产品落地能力，不贪图一时侥幸，能够依靠模式升级实现财富的阶梯式跃迁。";
        advice = [
          "适合副业赛道：SaaS工具研发、私域流量矩阵、高壁垒品牌代运营",
          "幸运增运颜色：翡翠绿、墨黑色",
          "财富贵人属相：属猪、属兔、属羊之人"
        ];
        avoid = "注意防范合作人团队内部利益分配不均，合同需做到白纸黑字明确分红机制。";
      }

      document.getElementById('repTier').innerText = tier;
      document.getElementById('repTierDesc').innerText = tierDesc;
      document.getElementById('repDiagnosis').innerText = diagnosis;
      
      const adviceUl = document.getElementById('repAdviceList');
      adviceUl.innerHTML = '';
      advice.forEach(item => {
        const li = document.createElement('li');
        li.innerText = item;
        adviceUl.appendChild(li);
      });

      document.getElementById('repAvoid').innerText = avoid;

      // Switch View first so Canvas has element dimensions
      switchView('viewReport');

      // Draw Native Radar Charts
      setTimeout(() => {
        drawFiveElementsCanvas(state.wuxingScores);
        drawBusinessRadarCanvas(state.businessScores);
      }, 100);
    }

    function drawFiveElementsCanvas(scores) {
      const canvas = document.getElementById('canvasFiveElements');
      const ctx = canvas.getContext('2d');
      const width = canvas.width;
      const height = canvas.height;
      
      ctx.clearRect(0, 0, width, height);

      const centerX = width / 2;
      const centerY = height / 2 - 10;
      const radius = 80;

      // 5 Elements Pentagram Order: Wood(木), Fire(火), Earth(土), Metal(金), Water(水)
      const labels = [
        { name: '木 (生发)', key: 'wood', color: '#4ADE80' },
        { name: '火 (爆发)', key: 'fire', color: '#F87171' },
        { name: '土 (承载)', key: 'earth', color: '#FACC15' },
        { name: '金 (收敛)', key: 'metal', color: '#E2E8F0' },
        { name: '水 (流动)', key: 'water', color: '#60A5FA' }
      ];

      const angles = labels.map((_, i) => (Math.PI * 2 / 5) * i - Math.PI / 2);

      // Draw Grid Webs
      for (let r = 0.2; r <= 1.0; r += 0.2) {
        ctx.beginPath();
        for (let i = 0; i < 5; i++) {
          const x = centerX + Math.cos(angles[i]) * radius * r;
          const y = centerY + Math.sin(angles[i]) * radius * r;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.strokeStyle = 'rgba(212, 175, 55, 0.15)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      // Draw Axis Lines
      for (let i = 0; i < 5; i++) {
        ctx.beginPath();
        ctx.moveTo(centerX, centerY);
        ctx.lineTo(centerX + Math.cos(angles[i]) * radius, centerY + Math.sin(angles[i]) * radius);
        ctx.strokeStyle = 'rgba(212, 175, 55, 0.2)';
        ctx.stroke();
      }

      // Draw User Data Polygon
      ctx.beginPath();
      labels.forEach((item, i) => {
        const val = Math.min(100, Math.max(10, scores[item.key] * 2.5)); // Scale for visual
        const r = (val / 100) * radius;
        const x = centerX + Math.cos(angles[i]) * r;
        const y = centerY + Math.sin(angles[i]) * r;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.closePath();
      ctx.fillStyle = 'rgba(212, 175, 55, 0.35)';
      ctx.fill();
      ctx.strokeStyle = '#D4AF37';
      ctx.lineWidth = 2;
      ctx.stroke();

      // Draw Labels
      ctx.font = '11px sans-serif';
      labels.forEach((item, i) => {
        const x = centerX + Math.cos(angles[i]) * (radius + 22);
        const y = centerY + Math.sin(angles[i]) * (radius + 18);
        ctx.fillStyle = item.color;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(`${item.name} ${scores[item.key]}%`, x, y);
      });

      // Update text under canvas
      document.getElementById('wuxingRatioText').innerText = 
        `木:${scores.wood}% | 火:${scores.fire}% | 土:${scores.earth}% | 金:${scores.metal}% | 水:${scores.water}%`;
    }

    function drawBusinessRadarCanvas(scores) {
      const canvas = document.getElementById('canvasBusinessRadar');
      const ctx = canvas.getContext('2d');
      const width = canvas.width;
      const height = canvas.height;
      
      ctx.clearRect(0, 0, width, height);

      const centerX = width / 2;
      const centerY = height / 2 - 5;
      const radius = 75;

      const labels = [
        { name: '商业战略', key: 'strategy' },
        { name: '落地执行', key: 'execution' },
        { name: '资源杠杆', key: 'resource' },
        { name: '风口敏锐度', key: 'wind' }
      ];

      const angles = labels.map((_, i) => (Math.PI * 2 / 4) * i - Math.PI / 2);

      // Draw Grid Webs
      for (let r = 0.25; r <= 1.0; r += 0.25) {
        ctx.beginPath();
        for (let i = 0; i < 4; i++) {
          const x = centerX + Math.cos(angles[i]) * radius * r;
          const y = centerY + Math.sin(angles[i]) * radius * r;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
        ctx.stroke();
      }

      // Draw Data Polygon
      ctx.beginPath();
      labels.forEach((item, i) => {
        const val = scores[item.key];
        const r = (val / 100) * radius;
        const x = centerX + Math.cos(angles[i]) * r;
        const y = centerY + Math.sin(angles[i]) * r;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.closePath();
      ctx.fillStyle = 'rgba(200, 60, 35, 0.35)'; // Vermilion glow
      ctx.fill();
      ctx.strokeStyle = '#C83C23';
      ctx.lineWidth = 2;
      ctx.stroke();

      // Labels
      ctx.font = '11px sans-serif';
      ctx.fillStyle = '#E2E8F0';
      labels.forEach((item, i) => {
        const x = centerX + Math.cos(angles[i]) * (radius + 20);
        const y = centerY + Math.sin(angles[i]) * (radius + 14);
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(`${item.name} (${scores[item.key]})`, x, y);
      });
    }

    const FORTUNE_STICKS = [
      { title: "【上上签·日进斗金】", text: "吉星照耀财帛宫，今日宜谈合作、签合同、上线新项目，逢出必中！" },
      { title: "【中吉签·财源稳广】", text: "水木相生利复利，今日宜深耕既有业务，整理账目，必有意外小惊喜。" },
      { title: "【上吉签·贵人相助】", text: "火生土旺气场高，今日宜主动联系行业前辈或高维圈层，能获关键点拨。" },
      { title: "【平吉签·守正待时】", text: "金水对冲需沉着，今日宜多听少动，避免冲动消费与无意义人情买单。" }
    ];

    function drawFortuneStick() {
      const box = document.getElementById('stickBox');
      box.classList.add('shaking');

      setTimeout(() => {
        box.classList.remove('shaking');
        const randomIndex = Math.floor(Math.random() * FORTUNE_STICKS.length);
        const fortune = FORTUNE_STICKS[randomIndex];

        document.getElementById('stickTitle').innerText = fortune.title;
        document.getElementById('stickText').innerText = fortune.text;
        document.getElementById('stickResult').classList.remove('hidden');

        showToast('已为您解签！');
      }, 800);
    }

    function exportReportImage() {
      showToast('正在生成高清晰度报告长图...');
      const target = document.getElementById('reportExportArea');

      html2canvas(target, {
        backgroundColor: '#0D0E12',
        scale: 2,
        useCORS: true
      }).then(canvas => {
        const image = canvas.toDataURL("image/png");
        const link = document.createElement('a');
        link.download = `${state.userName}_五行财富爆发力测评报告.png`;
        link.href = image;
        link.click();
        showToast('长图已成功下载至本地！');
      }).catch(err => {
        showToast('生成图片失败，请稍后重试');
        console.error(err);
      });
    }

    function copyResultLink() {
      const dummyUrl = window.location.href.split('#')[0] + `#res=${encodeURIComponent(state.userName)}`;
      const input = document.createElement('input');
      input.value = dummyUrl;
      document.body.appendChild(input);
      input.select();
      document.execCommand('copy');
      document.body.removeChild(input);

      showToast('测评结果链接已复制到剪贴板！');
    }

    function showGiftModal() {
      document.getElementById('giftModal').classList.remove('hidden');
    }

    function hideGiftModal() {
      document.getElementById('giftModal').classList.add('hidden');
    }

    function restartTest() {
      if (state.remainingCount <= 0) {
        showToast('当前激活码剩余测试次数已用完');
        switchView('viewPassword');
        return;
      }
      switchView('viewQuiz');
      state.currentQuestionIndex = 0;
      state.answers.fill(null);
      renderQuestion();
    }

    /* =========================================================================
       4. UI UTILITIES & ROUTER
       ========================================================================= */
    function switchView(viewId) {
      const views = ['viewPassword', 'viewBirthInfo', 'viewQuiz', 'viewReport'];
      views.forEach(v => {
        const el = document.getElementById(v);
        if (v === viewId) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showToast(msg) {
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2500);
    }
  </script>
</body>
</html>
