                "火": "【爆发/烈火局】：天生行动力极强，对风口与商业机会极具直觉。极具决断力，在上升周期中往往能果断出手抓住大机会实现阶层跨越。",
                "earth": "【财库/厚德局】：天生沉稳踏实，资产防守能力强。注重落地与实物资产，能够守住财富，通过稳健蓄力构建坚不可摧的家庭财务后盾。"
            };
            document.getElementById('res-innate-desc').innerText = innateMap[bazi.dayElement] || innateMap["金"];

            let maxKey = "gold";
            let maxVal = -1;
            for (let k in scores) {
                if (scores[k] > maxVal) { maxVal = scores[k]; maxKey = k; }
            }

            const elementConfig = {
                gold: {
                    type: "【金系·锐意进取型】",
                    logic: "2027年你的财富爆发力来自“极度理性与精细化防守”。你善于去杠杆、剔除无用开支，并在不确定性中锁定确定性收益。",
                    advice: "建议配置70%稳健固收/现金类资产作为现金流防线，30%布局低估值优质核心标的。适合发挥精细化管账与防坑优势。",
                    risk: "切忌过于死板或过度悲观而错失微观创新机会；避免因对规则过于苛刻而影响团队或合伙合作。"
                },
                wood: {
                    type: "【木系·生生不息型】",
                    logic: "2027年你的财富爆发力来自“技能壁垒与长期成长”。依靠知识、技术、健康或个人IP的沉淀，呈现复利增长态势。",
                    advice: "重点投资自身的“不可替代性”，开发1-2门轻资产副业。资金配置宜采用定投策略，分享优质资产的长远红利。",
                    risk: "小心陷入“只埋头苦干不看路”的误区；避免前期投入过大而忽视了短期现金流的补充。"
                },
                water: {
                    type: "【水系·上善若水型】",
                    logic: "2027年你的财富爆发力来自“资源整合与借力打力”。你对市场情绪与人际需求感知敏锐，能通过合作与信息差获利。",
                    advice: "适合做轻资产轻运营项目，多参与优质圈子交流。保持资金的高流动性，随时准备捕捉阶段性套利机会。",
                    risk: "注意防范因人情借贷、合伙账目不清造成的隐性损失;切勿因跟风炒作而高位套牢。"
                },
                fire: {
                    type: "【火系·烈火燎原型】",
                    logic: "2027年你的财富爆发力来自“风口决断与高执行力”。在新的消费趋势、AI工具或短视频赛道中极具爆发潜能。",
                    advice: "适合集中优势兵力打歼灭战，抓住1-2次风口迅速完成积累。注意做好止盈机制，获利后及时落袋为安。",
                    risk: "高收益伴随高风险，严控杠杆与情绪化投资；切勿在未经验证的项目中一次性押上全部身家。"
                },
                earth: {
                    type: "【土系·厚德载物型】",
                    logic: "2027年你的财富爆发力来自“稳扎稳打与稳健蓄力”。你追求极高的安全感，能帮自己和家庭筑牢财务护城河。",
                    advice: "以保本和抗通胀为第一要务，重点关注高股息、优质固收及实物资产.适合建立家庭紧急避险基金。",
                    risk: "谨防过分保守而导致资产被通胀缓慢侵蚀；在面对明显的新时代技术红利时可适当保持开放度。"
                }
            };

            const cfg = elementConfig[maxKey];
            document.getElementById('res-element-type').innerText = cfg.type;
            document.getElementById('res-logic').innerText = cfg.logic;
            document.getElementById('res-advice').innerText = cfg.advice;
            document.getElementById('res-risk').innerText = cfg.risk;

            renderRadarChart();
        }

        function renderRadarChart() {
            const ctx = document.getElementById('radarChart').getContext('2d');
            if (myChart) myChart.destroy();

            myChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['金 (稳健精算)', '木 (技能成长)', '水 (资源整合)', '火 (风口爆发)', '土 (稳健防守)'],
                    datasets: [{
                        label: '2027财富爆发指数',
                        data: [scores.gold, scores.wood, scores.water, scores.fire, scores.earth],
                        backgroundColor: 'rgba(212, 175, 55, 0.25)',
                        borderColor: '#d4af37',
                        pointBackgroundColor: '#fff2a3',
                        pointBorderColor: '#d4af37',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            angleLines: { color: 'rgba(212, 175, 55, 0.2)' },
                            grid: { color: 'rgba(212, 175, 55, 0.2)' },
                            pointLabels: { color: '#f3e5ab', font: { size: 10, weight: 'bold' } },
                            ticks: { display: false },
                            suggestedMin: 0
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        function drawStick() {
            const box = document.getElementById('stick-box');
            box.classList.add('shake-animation');
            setTimeout(() => {
                box.classList.remove('shake-animation');
                const randomStick = fortuneSticks[Math.floor(Math.random() * fortuneSticks.length)];
                document.getElementById('draw-before').classList.add('hidden');
                document.getElementById('draw-after').classList.remove('hidden');
                document.getElementById('stick-title').innerText = randomStick.title;
                document.getElementById('stick-poem').innerText = randomStick.poem;
                document.getElementById('stick-explain').innerText = randomStick.explain;
            }, 800);
        }

        function savePoster() {
            const area = document.getElementById('poster-area');
            if (typeof html2canvas === 'undefined') {
                alert("海报生成插件加载中或被拦截，请稍后再试，或直接长按屏幕截图保存！");
                return;
            }
            
            // 【核心优化】：配置 html2canvas 锁定缩放比例，防止字体偏移与模糊
            html2canvas(area, {
                backgroundColor: '#0a0a0f',
                scale: 2,               // 提高清晰度
                useCORS: true,
                logging: false,
                letterRendering: true   // 优化文字渲染间距，防止偏移
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = `2027财富指数测评_${userData.name}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            }).catch(err => {
                alert("海报生成失败，请直接长按屏幕截图保存！");
            });
        }

        function shareTest() {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(window.location.href);
                alert("测评链接已复制到剪贴板，快分享给好友吧！");
            } else {
                alert("请直接复制当前网页网址分享给好友！");
            }
        }

        function reTest() {
            const uses = getKeyUses(currentKey);
            if (uses <= 0) {
                alert("当前密钥的 3 次测评次数已用尽！请更换新密钥。");
                location.reload();
                return;
            }
            userAnswers = [];
            currentQuestionIdx = 0;
            document.getElementById('draw-before').classList.remove('hidden');
            document.getElementById('draw-after').classList.add('hidden');
            document.getElementById('sec-result').classList.add('hidden');
            document.getElementById('sec-bazi').classList.remove('hidden');
        }
    </script>
</body>
</html>
