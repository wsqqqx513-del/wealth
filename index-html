<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>2027年五行财富爆发力与天命财局测评</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- html2canvas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            light: '#f3e5ab',
                            DEFAULT: '#d4af37',
                            dark: '#aa7c11',
                        },
                        darkbg: '#0a0a0f',
                        cardbg: 'rgba(26, 26, 36, 0.9)',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0a0a0f;
            color: #e2e8f0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-image: 
                radial-gradient(circle at 50% 20%, rgba(212, 175, 55, 0.15) 0%, transparent 45%),
                radial-gradient(circle at 80% 80%, rgba(170, 124, 17, 0.1) 0%, transparent 30%);
            background-attachment: fixed;
        }

        .gold-border {
            border: 1px solid #d4af37;
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.25);
        }

        .gold-text-gradient {
            background: linear-gradient(135deg, #fff2a3 0%, #d4af37 50%, #aa7c11 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gold-btn {
            background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%);
            color: #000;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .gold-btn:hover {
            opacity: 0.9;
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.6);
            transform: translateY(-1px);
        }

        .compass-spin {
            animation: spin 10s linear infinite;
        }

        @keyframes spin {
            100% { transform: rotate(360deg); }
        }

        .shake-animation {
            animation: shake 0.5s ease-in-out infinite;
        }

        @keyframes shake {
            0% { transform: rotate(0deg); }
            20% { transform: rotate(-10deg); }
            40% { transform: rotate(10deg); }
            60% { transform: rotate(-5deg); }
            80% { transform: rotate(5deg); }
            100% { transform: rotate(0deg); }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-between p-4 sm:p-6">

    <!-- 顶部 Header -->
    <header class="w-full max-w-md text-center pt-2 pb-3 border-b border-gold/30 mb-2">
        <h1 class="text-xl sm:text-2xl font-bold gold-text-gradient tracking-widest">2027 丁未年</h1>
        <p class="text-xs text-amber-200/70 tracking-wider mt-0.5">五行财富爆发力与天命财局测评</p>
    </header>

    <!-- 主体容器 -->
    <main class="w-full max-w-md flex-1 flex flex-col justify-center pb-6">

        <!-- 1. 密钥输入界面 -->
        <section id="sec-key" class="bg-cardbg p-6 sm:p-8 rounded-2xl gold-border backdrop-blur-md my-auto">
            <div class="text-center mb-6">
                <div class="inline-block p-3 rounded-full bg-gold/10 border border-gold/40 mb-3 shadow-inner">
                    <i class="fa-solid fa-key text-gold text-2xl"></i>
                </div>
                <h2 class="text-xl font-bold text-amber-100">输入激活密码</h2>
                <p class="text-xs text-gray-400 mt-1">请输入专属 8 位激活密钥进入测试</p>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs text-amber-200/80 mb-2 font-medium">8位激活密钥（不区分大小写）</label>
                    <input type="text" id="input-key" maxlength="8" placeholder="请输入8位数字或字母" 
                        class="w-full bg-black/70 border border-amber-500/50 rounded-xl px-4 py-3.5 text-center text-xl text-gold tracking-widest uppercase focus:outline-none focus:border-gold shadow-inner">
                </div>

                <div id="key-error" class="text-red-400 text-xs text-center hidden bg-red-950/40 py-2 rounded-lg border border-red-500/30">
                    <i class="fa-solid fa-circle-exclamation mr-1"></i>密钥无效或测评次数已耗尽！
                </div>

                <button onclick="verifyKey()" class="w-full py-3.5 rounded-xl gold-btn text-center font-bold text-base shadow-lg mt-2">
                    验证并开启测评
                </button>
            </div>
        </section>

        <!-- 2. 八字与个人信息输入界面 -->
        <section id="sec-bazi" class="bg-cardbg p-6 rounded-2xl gold-border backdrop-blur-md hidden my-auto">
            <div class="text-center mb-6">
                <h2 class="text-xl font-bold gold-text-gradient">排算生辰八字</h2>
                <p class="text-xs text-gray-400 mt-1">输入出生信息，结合2027流年推演财运格局</p>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs text-amber-200/80 mb-1">您的姓名 / 称呼</label>
                    <input type="text" id="user-name" placeholder="请输入您的姓名" class="w-full bg-black/60 border border-amber-500/40 rounded-xl px-4 py-2.5 text-amber-100 focus:outline-none focus:border-gold">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-amber-200/80 mb-1">性别</label>
                        <select id="user-gender" class="w-full bg-black/60 border border-amber-500/40 rounded-xl px-3 py-2.5 text-amber-100 focus:outline-none focus:border-gold">
                            <option value="乾造">男 (乾造)</option>
                            <option value="坤造">女 (坤造)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs text-amber-200/80 mb-1">出生时辰</label>
                        <select id="user-hour" class="w-full bg-black/60 border border-amber-500/40 rounded-xl px-3 py-2.5 text-amber-100 focus:outline-none focus:border-gold">
                            <option value="0">子时 (23:00-01:00)</option>
                            <option value="2">丑时 (01:00-03:00)</option>
                            <option value="4">寅时 (03:00-05:00)</option>
                            <option value="6">卯时 (05:00-07:00)</option>
                            <option value="8">辰时 (07:00-09:00)</option>
                            <option value="10">巳时 (09:00-11:00)</option>
                            <option value="12">午时 (11:00-13:00)</option>
                            <option value="14">未时 (13:00-15:00)</option>
                            <option value="16">申时 (15:00-17:00)</option>
                            <option value="18">酉时 (17:00-19:00)</option>
                            <option value="20">戌时 (19:00-21:00)</option>
                            <option value="22">亥时 (21:00-23:00)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs text-amber-200/80 mb-1">公历出生日期</label>
                    <input type="date" id="user-dob" value="1995-06-15" class="w-full bg-black/60 border border-amber-500/40 rounded-xl px-4 py-2.5 text-amber-100 focus:outline-none focus:border-gold">
                </div>

                <button onclick="startQuiz()" class="w-full py-3.5 rounded-xl gold-btn text-center font-bold text-base shadow-lg mt-4">
                    开始2027财富测评 <i class="fa-solid fa-compass ml-1"></i>
                </button>
            </div>
        </section>

        <!-- 3. 八字罗盘推演动画蒙层 -->
        <div id="anim-overlay" class="fixed inset-0 bg-black/90 z-50 flex flex-col items-center justify-center hidden">
            <div class="relative w-48 h-48 flex items-center justify-center">
                <div class="absolute inset-0 border-2 border-dashed border-gold rounded-full compass-spin"></div>
                <div class="text-gold text-5xl"><i class="fa-solid fa-yin-yang"></i></div>
            </div>
            <p id="anim-text" class="text-gold font-bold text-lg mt-6 tracking-widest">推演乾坤八字中...</p>
        </div>

        <!-- 4. 25题通俗问答界面 -->
        <section id="sec-quiz" class="bg-cardbg p-6 rounded-2xl gold-border backdrop-blur-md hidden">
            <div class="mb-4">
                <div class="flex justify-between text-xs text-amber-200/80 mb-1">
                    <span id="quiz-progress-text">问题 1 / 25</span>
                    <span id="quiz-percent-text">4%</span>
                </div>
                <div class="w-full bg-black/50 h-2 rounded-full overflow-hidden border border-gold/30">
                    <div id="quiz-progress-bar" class="bg-gradient-to-r from-amber-600 to-gold h-full transition-all duration-300" style="width: 4%;"></div>
                </div>
            </div>

            <div id="quiz-content" class="min-h-[220px] flex flex-col justify-between">
                <h3 id="q-title" class="text-base font-bold text-amber-100 mb-4 leading-relaxed">
                    加载中...
                </h3>
                <div id="q-options" class="space-y-3 mb-4"></div>
            </div>

            <div class="flex justify-between items-center mt-4 pt-3 border-t border-amber-500/20">
                <button id="btn-prev" onclick="prevQuestion()" class="text-xs text-gray-400 hover:text-gold px-3 py-1.5 rounded border border-gray-700 hidden">
                    <i class="fa-solid fa-arrow-left mr-1"></i> 上一题
                </button>
                <div class="text-xs text-gray-500">选择后自动进入下一题</div>
            </div>
        </section>

        <!-- 5. 测评结果界面 -->
        <section id="sec-result" class="space-y-6 hidden">
            <div id="poster-area" class="bg-[#1a1a24] p-6 rounded-2xl gold-border backdrop-blur-md relative" style="transform: scale(1); transform-origin: top left;">
                
                <div class="border-b border-gold/30 pb-4 mb-4 text-center">
                    <span class="inline-block bg-gold/20 text-gold text-xs px-3 py-1 rounded-full border border-gold/40">2027 丁未流年专属报告</span>
                    <h2 class="text-2xl font-bold text-amber-100 mt-2" id="res-user-name">--</h2>
                    <p class="text-xs text-amber-200/80 mt-1" id="res-bazi-str">八字命盘加载中...</p>
                </div>

                <div class="bg-black/40 p-4 rounded-xl border border-amber-500/30 mb-6">
                    <h3 class="text-sm font-bold text-gold flex items-center mb-2">
                        <i class="fa-solid fa-coins mr-2"></i> 天生财运与格局分析
                    </h3>
                    <p class="text-xs text-gray-300 leading-relaxed" id="res-innate-desc">加载中...</p>
                </div>

                <div class="mb-6">
                    <h3 class="text-sm font-bold text-gold text-center mb-2">2027 财富爆发力五维图</h3>
                    <div class="w-full h-56 flex justify-center items-center">
                        <canvas id="radarChart"></canvas>
                    </div>
                </div>

                <div class="bg-gradient-to-b from-amber-950/40 to-black/60 p-4 rounded-xl border border-gold/40 mb-6">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs text-amber-300">2027年主导财运型态</span>
                        <span id="res-element-type" class="text-lg font-bold gold-text-gradient">--</span>
                    </div>
                    <div class="space-y-3 text-xs">
                        <div>
                            <span class="text-amber-200/90 font-bold block mb-0.5">💰 财富底层逻辑：</span>
                            <p id="res-logic" class="text-gray-300 leading-relaxed">--</p>
                        </div>
                        <div>
                            <span class="text-amber-200/90 font-bold block mb-0.5">📈 2027理财与投资配置建议：</span>
                            <p id="res-advice" class="text-gray-300 leading-relaxed">--</p>
                        </div>
                        <div>
                            <span class="text-red-300 font-bold block mb-0.5">⚠️ 关键避坑与风险提示：</span>
                            <p id="res-risk" class="text-gray-300 leading-relaxed">--</p>
                        </div>
                    </div>
                </div>

                <div class="bg-black/50 p-4 rounded-xl border border-gold/30 text-center relative overflow-hidden">
                    <h3 class="text-sm font-bold text-gold mb-2">抽取 2027 财运灵签</h3>
                    
                    <div id="draw-before" class="py-4">
                        <div id="stick-box" class="w-16 h-20 mx-auto bg-amber-900/60 border-2 border-gold rounded-t-lg flex items-end justify-center pb-2 cursor-pointer" onclick="drawStick()">
                            <i class="fa-solid fa-scroll text-gold text-2xl"></i>
                        </div>
                        <p class="text-xs text-amber-200/70 mt-3">点击签筒，求取 2027 财富指引</p>
                    </div>

                    <div id="draw-after" class="hidden space-y-2">
                        <div class="inline-block bg-gold/20 text-gold font-bold px-4 py-1 rounded-full text-base border border-gold" id="stick-title">--</div>
                        <p class="text-xs text-amber-100 font-semibold italic" id="stick-poem">"--"</p>
                        <p class="text-xs text-gray-300 leading-relaxed pt-1" id="stick-explain">--</p>
                    </div>
                </div>

                <div class="mt-4 text-center">
                    <p class="text-[10px] text-gray-500">2027财富指数测评 · 专属天命报告</p>
                </div>
            </div>

            <div class="space-y-3">
                <button onclick="savePoster()" class="w-full py-3.5 rounded-xl gold-btn text-center font-bold text-sm shadow-lg">
                    <i class="fa-solid fa-download mr-1"></i> 保存结果海报至相册
                </button>
                
                <div class="grid grid-cols-2 gap-3">
                    <button onclick="shareTest()" class="py-3 rounded-xl bg-amber-950/80 border border-gold/50 text-gold font-bold text-xs">
                        <i class="fa-solid fa-share-nodes mr-1"></i> 分享给好友
                    </button>
                    <button onclick="reTest()" class="py-3 rounded-xl bg-gray-900 border border-gray-700 text-gray-300 font-bold text-xs">
                        <i class="fa-solid fa-rotate-right mr-1"></i> 重新测评 (<span id="rem-uses">--</span>次)
                    </button>
                </div>
            </div>
        </section>

    </main>

